# The signalling worker's URL — see workers/signalling/README.md for
# deploying it. Only needed for the short-code table-join path; the app
# works without it (falls back to a code you paste by hand).
#
# Local dev needs nothing here: it defaults to `wrangler dev`'s address,
# http://localhost:8787. A deployed build should set this to the worker's
# real URL, e.g. https://magical-life-signalling.<your-subdomain>.workers.dev
VITE_SIGNALLING_URL=

# The commit this build is from, shown small in a corner of the app. CI sets
# this to the actual commit SHA; local dev has no fixed build to name, so it
# just shows "dev" if left unset here too.
VITE_APP_VERSION=
