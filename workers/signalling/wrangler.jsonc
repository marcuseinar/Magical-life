{
  "name": "magical-life-signalling",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-26",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SignallingRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignallingRoom"] }],
  "vars": {
    // The static site's own origins. A GitHub Pages PR preview
    // (pr-<number>/) shares the https://<owner>.github.io origin with
    // production, so it does not need its own entry. 5173 is `vite dev`;
    // 4173 is `vite preview` — the production-shaped build Playwright's
    // e2e suite actually runs against, per playwright.config.ts.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://marcuseinar.github.io"
  }
}
